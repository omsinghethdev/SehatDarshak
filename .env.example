# SehatDarshak Docker configuration. Copy to ".env" in this folder (it is git-ignored) and fill
# in your own values. Never commit .env. This file is read by Docker Compose only; server/.env and
# client/.env (for running without Docker) are separate and are NOT copied into the images.
#
# Generate each secret/password with (URL-safe, so it can go inside a MongoDB URI):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Where each value goes:
#   [compose]  used by Docker Compose itself (ports, which addresses to bind)
#   [mongo]    passed to the MongoDB container (first start only: users are created once)
#   [backend]  passed to the API container at runtime
#   [web]      baked into the frontend bundle at BUILD time; rebuild after changing it

# --- Public address -----------------------------------------------------------------------
# [backend][web] The exact address users open in the browser (scheme + host + port, no path).
# Used as the API's allowed CORS origin and to print the demo QR codes. Must match WEB_PORT
# locally, e.g. http://localhost:8080; on a server, e.g. https://sehatdarshak.example.org
APP_ORIGIN=http://localhost:8080

# [compose] Host port of the web service, published on all network interfaces. Control who can
# reach it with the firewall (on AWS: the security group).
WEB_PORT=8080

# --- API ----------------------------------------------------------------------------------
# [backend] Signs sign-in tokens. At least 32 characters, random, unique per environment.
AUTH_SECRET=replace-with-a-long-random-secret
# [backend] Optional sign-in lifetime (number + s/m/h/d). Default 1h.
AUTH_TOKEN_EXPIRES_IN=1h
# [backend] Optional IANA time zone for service dates and reports. Default Asia/Kolkata.
HOSPITAL_TIMEZONE=Asia/Kolkata
# [backend] Number of reverse proxies in front of the API. 1 = the web service's Nginx.
# Use 2 only if another proxy/load balancer (e.g. an AWS ALB) is in front of the web service.
TRUST_PROXY=1

# --- Database: local MongoDB container (compose.yaml, the default) ------------------------
# [mongo] Administrator account of the local MongoDB. Not given to the API.
MONGO_ROOT_USERNAME=sehat_root
MONGO_ROOT_PASSWORD=replace-with-a-random-password
# [mongo][backend] Read/write account the API uses, and the database name.
# Use URL-safe characters (letters, digits, - and _) because they go inside a URI.
MONGO_APP_USERNAME=sehat_app
MONGO_APP_PASSWORD=replace-with-a-different-random-password
MONGO_DB_NAME=sehatdarshak

# --- Database: external MongoDB such as Atlas (compose.external-db.yaml only) -------------
# [backend] Full connection string including the database name. Leave unset for local mode.
# EXTERNAL_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.example.mongodb.net/sehatdarshak?retryWrites=true&w=majority
