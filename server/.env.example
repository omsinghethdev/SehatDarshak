# Use local values in server/.env; never commit secrets or real patient data.
PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sehatdarshak
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Optional access-token lifetime: a whole number followed by s, m, h, or d (e.g. 15m, 1h, 7d). Defaults to 1h.
AUTH_TOKEN_EXPIRES_IN=1h
# Optional MongoDB server for DB-backed tests. Each test file uses its own
# sehatdarshak_<name>_test database on this server and drops it afterwards.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017
