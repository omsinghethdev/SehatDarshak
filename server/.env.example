# Use local values in server/.env; never commit secrets or real patient data.
PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sehatdarshak
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Optional access-token lifetime: a whole number followed by s, m, h, or d (e.g. 15m, 1h, 7d). Defaults to 1h.
AUTH_TOKEN_EXPIRES_IN=1h
# Optional IANA time zone for service dates, report periods, and daily trends. Defaults to Asia/Kolkata.
# HOSPITAL_TIMEZONE=Asia/Kolkata
# Optional MongoDB server for DB-backed tests. Each test file uses its own
# sehatdarshak_<name>_test database on this server and drops it afterwards.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# DEVELOPMENT ONLY: demo accounts created by `npm run seed:dev-users` (patient, staff, admin).
# The script refuses to run unless NODE_ENV=development, ALLOW_DEV_USER_SEED=true, and
# MONGODB_URI points to localhost. Choose your own passwords (8+ characters) in server/.env;
# never commit them, and never set these variables in production.
# NODE_ENV=development
# ALLOW_DEV_USER_SEED=true
# DEV_PATIENT_PASSWORD=
# DEV_STAFF_PASSWORD=
# DEV_ADMIN_PASSWORD=
# Optional; defaults shown.
# DEV_PATIENT_USERNAME=demo.patient
# DEV_STAFF_USERNAME=demo.staff
# DEV_ADMIN_USERNAME=demo.admin
# DEV_STAFF_DEPARTMENT_ID=dept_demo_opd
