# Public URL for the JSON API. Do not place secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:5000/api

# Authentication backend: "api" (default) calls the real server at VITE_API_BASE_URL.
# "mock" uses development-only demo accounts stored in this browser. Mock mode is not
# secure, is clearly labelled in the UI, and must never be used for real patient data.
VITE_AUTH_MODE=api
