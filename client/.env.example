# Public URL for the JSON API, including the /api prefix. Do not place secrets in VITE_ variables.
# The local server runs on 5001 (port 5000 is often taken by AirPlay Receiver on macOS); keep this
# in sync with PORT in server/.env.
VITE_API_BASE_URL=http://localhost:5001/api

# Authentication backend: "api" (default) calls the real server at VITE_API_BASE_URL.
# "mock" uses development-only demo accounts stored in this browser. Mock mode is not
# secure, is clearly labelled in the UI, and must never be used for real patient data.
VITE_AUTH_MODE=api

# Optional: average minutes per consultation. Used only to simulate mock waiting times and as a
# clearly labelled fallback when the service does not return its own estimate. Default 5.
# VITE_QUEUE_AVERAGE_SERVICE_MINUTES=5

# Optional: public address of this app, used only to build the demo QR codes on /qr-codes
# (e.g. https://sehatdarsak.example.org, or http://192.168.1.20:5173 for phones on the same
# Wi-Fi with "npm run dev -- --host"). Scanned links from this origin are also accepted.
# Defaults to the address the app is opened at, which phones cannot reach if it is localhost.
# VITE_PUBLIC_APP_URL=
